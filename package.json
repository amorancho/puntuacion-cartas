{
  "name": "marcador-de-cartas",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Marcador familiar de juegos de cartas, instalable y sin conexión.",
  "scripts": {
    "build": "tailwindcss -i ./src/css/input.css -o ./dist/css/styles.css -m && node ./scripts/build-site.mjs",
    "dev": "tailwindcss -i ./src/css/input.css -o ./dist/css/styles.css --watch",
    "serve": "node ./scripts/serve.mjs",
    "test": "node --test"
  },
  "devDependencies": {
    "tailwindcss": "3.4.17"
  }
}
